pkgname=libidn2
pkgver=2.3.8
pkgrel=0
pkgdesc="Free software implementation of IDNA2008, Punycode and TR46"
arch="all"
license="GPL-2.0-or-later OR LGPL-3.0-or-later"
depends="libunistring libiconv"
makedepends="libunistring-dev libiconv-dev"
url="https://www.gnu.org/software/libidn/#libidn2"
subpackages="$pkgname-doc $pkgname-dev"
source="https://mirror.csclub.uwaterloo.ca/gnu/libidn/$pkgname-$pkgver.tar.gz"

build() {
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --disable-static \
        --disable-rpath
    make
}

package() {
    make DESTDIR="${pkgdir}" install
}
sha512sums="
